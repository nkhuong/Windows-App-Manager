<Window x:Class="WindowsAppManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows App Manager" Width="1320" Height="840" MinWidth="1000" MinHeight="620"
        Background="{StaticResource Surface}" Foreground="{StaticResource Ink}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Title -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,17">
            <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="12" Background="#265DAC" Margin="0,0,14,0">
                <TextBlock Text="▦" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel>
                <TextBlock Text="Windows App Manager" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="WinGet · Scoop · Manual · planned installs" FontSize="12" Foreground="{StaticResource Soft}" />
            </StackPanel>
        </DockPanel>
        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,9,0">
                <TextBox x:Name="SearchBox" TextChanged="SearchChanged" Padding="9,0,40,0"
                         VerticalContentAlignment="Center" ToolTip="Search name, package ID or path"/>
                <Button Content="×" Click="ClearSearchClick" Width="32" MinHeight="28" Padding="0" Margin="0,3,3,3"
                        HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Clear search"/>
            </Grid>
            <ComboBox Grid.Column="1" x:Name="SourceFilter" Margin="0,0,9,0" SelectedIndex="0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="All sources"/><ComboBoxItem Content="WinGet"/><ComboBoxItem Content="Scoop"/>
                <ComboBoxItem Content="Manual"/><ComboBoxItem Content="GitHub"/><ComboBoxItem Content="MSIX"/>
            </ComboBox>
            <ComboBox Grid.Column="2" x:Name="StatusFilter" Margin="0,0,9,0" SelectedIndex="0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="All apps"/><ComboBoxItem Content="Installed"/><ComboBoxItem Content="Not installed"/>
                <ComboBoxItem Content="Updates"/><ComboBoxItem Content="Planned"/>
            </ComboBox>
            <Button Grid.Column="3" Content="↻  Refresh" Click="RefreshClick" />
            <Button Grid.Column="4" Content="Check updates" Click="UpdatesClick" Margin="0" />
        </Grid>
        <!-- Quick actions -->
        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="InstalledFilterButton" Click="ShowInstalledClick" ToolTip="Click again to show all apps" Background="{StaticResource Panel}" Padding="14,8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Installed  " Foreground="{StaticResource Soft}"/><TextBlock x:Name="InstalledCount" FontWeight="Bold" Text="—" /></StackPanel>
                </Button>
                <Button x:Name="PlannedFilterButton" Click="ShowPlannedClick" ToolTip="Click again to show all apps" Background="{StaticResource Panel}" Padding="14,8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Planned  " Foreground="{StaticResource Soft}"/><TextBlock x:Name="PlannedCount" FontWeight="Bold" Text="—" /></StackPanel>
                </Button>
                <Button x:Name="UpdatesFilterButton" Click="ShowUpdatesClick" ToolTip="Click again to show all apps" Background="{StaticResource Panel}" Padding="14,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Updates  " Foreground="{StaticResource Soft}"/><TextBlock x:Name="UpdatesCount" FontWeight="Bold" Text="—" /></StackPanel>
                </Button>
                <Button Content="Scoop" x:Name="ScoopFilterButton" Click="ShowScoopClick" ToolTip="Click again to show all apps" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="InstallScoopButton" Content="Install Scoop" Click="InstallScoopClick" Visibility="Collapsed"/>
                <Button Content="Search new app" Click="SearchNewClick" />
                <Button Content="+ Add planned" Background="{StaticResource Accent}" Margin="0" Click="AddClick" />
            </StackPanel>
        </Grid>
        <!-- Main content -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="12" Padding="7">
                <DataGrid x:Name="AppsGrid" ItemsSource="{Binding DisplayItems}" SelectionChanged="SelectionChanged"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="43"
                          SelectionMode="Single" Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
                          BorderThickness="0" RowBackground="{StaticResource Panel}" AlternatingRowBackground="#1A283B"
                          HorizontalGridLinesBrush="{StaticResource Line}" VerticalGridLinesBrush="{StaticResource Line}"
                          SelectionUnit="FullRow" CanUserResizeRows="False">
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="9,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#26364D"/>
                            <Setter Property="Foreground" Value="{StaticResource Soft}"/>
                            <Setter Property="Padding" Value="10,12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#315782" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#315782"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="1.7*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.1*"/>
                        <DataGridTextColumn Header="Version" Binding="{Binding VersionText}" Width="0.9*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="0.85*"/>
                        <DataGridTextColumn Header="Installed" Binding="{Binding DateText}" Width="0.9*"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding ManagedBy}" Width="0.8*"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding PathText}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailsPanel" DataContext="{x:Null}">
                        <TextBlock Text="APP DETAILS" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Name, FallbackValue='Select an app'}" FontSize="20" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,12,0,6"/>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Soft}" Margin="0,0,0,15"/>
                        <Separator Margin="0,0,0,12" Opacity="0.25"/>
                        <TextBlock Text="Installed via" Foreground="{StaticResource Soft}"/>
                        <TextBlock Text="{Binding InstalledVia}" Margin="0,3,0,12"/>
                        <TextBlock Text="Managed by" Foreground="{StaticResource Soft}"/>
                        <TextBlock Text="{Binding ManagedBy}" Margin="0,3,0,12"/>
                        <TextBlock Text="Package ID" Foreground="{StaticResource Soft}"/>
                        <TextBlock Text="{Binding PackageId}" TextWrapping="Wrap" Margin="0,3,0,12"/>
                        <TextBlock Text="Install path" Foreground="{StaticResource Soft}"/>
                        <TextBlock Text="{Binding PathText}" TextWrapping="Wrap" Margin="0,3,0,12"/>
                        <TextBlock Text="Latest version" Foreground="{StaticResource Soft}"/>
                        <TextBlock Text="{Binding LatestVersion}" Margin="0,3,0,19"/>
                        <Button x:Name="ReleasesButton" Content="Open GitHub releases" Margin="0,0,0,8" Click="ReleasesClick" Visibility="Collapsed"/>
                        <Button x:Name="InstallButton" Content="Install" Background="{StaticResource Accent}" Margin="0,0,0,8" Click="InstallClick" IsEnabled="False"/>
                        <Button x:Name="UpgradeButton" Content="Upgrade" Margin="0,0,0,8" Click="UpgradeClick" IsEnabled="False"/>
                        <Button x:Name="UninstallButton" Content="Uninstall" Margin="0,0,0,8" Click="UninstallClick" IsEnabled="False"/>
                        <Button x:Name="BackupButton" Content="Backup files" Margin="0,0,0,8" Click="BackupClick" IsEnabled="False"/>
                        <Button x:Name="OpenFolderButton" Content="Open folder" Margin="0,0,0,8" Click="OpenFolderClick" IsEnabled="False"/>
                        <Button x:Name="EditPlanButton" Content="Edit planned app" Click="EditPlanClick" IsEnabled="False" Margin="0,0,0,8"/>
                        <Button x:Name="RemovePlanButton" Content="Delete from plan" Margin="0" Click="RemovePlanClick" IsEnabled="False"/>
                        <TextBlock Text="Install / uninstall / upgrade require confirmation. Backups never delete source files."
                                   Foreground="{StaticResource Soft}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <!-- Status -->
        <DockPanel Grid.Row="4" Margin="0,15,0,0" LastChildFill="True">
            <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="115" Height="5" IsIndeterminate="True"
                         Visibility="Collapsed" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Soft}" Text="Ready" FontSize="12"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
