<Window x:Class="WindowsAppManager.Dialogs.OutputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command output" Width="830" Height="600" Background="{StaticResource Surface}" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBox x:Name="Output" Grid.Row="1" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        <Button x:Name="CloseButton" Grid.Row="2" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0" Click="CloseClick" />
    </Grid>
</Window>
