<Window x:Class="WindowsAppManager.Dialogs.AddAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to planned apps" Height="355" Width="500" Background="{StaticResource Surface}" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Add an app" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Save an app for installation now or after reinstalling Windows." Foreground="{StaticResource Soft}" Margin="0,5,0,7" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Display name" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Source" Margin="0,0,0,4" />
            <ComboBox x:Name="SourceBox" SelectedIndex="0">
                <ComboBoxItem Content="WinGet"/><ComboBoxItem Content="Scoop"/>
                <ComboBoxItem Content="Manual"/><ComboBoxItem Content="GitHub"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Package ID / GitHub repository URL / Manual local path" Margin="0,0,0,4" />
            <TextBox x:Name="IdBox" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Cancel" Click="CancelClick" />
            <Button Content="Save" Background="{StaticResource Accent}" Click="SaveClick" />
        </StackPanel>
    </Grid>
</Window>
